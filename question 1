#include <stdio.h>

int main()
{
    double price, qty, senior;
    double gross, discount, taxable;
    double gst, total, net;

    printf("Enter price, quantity and senior status (1/0): ");
    scanf("%lf %lf %lf", &price, &qty, &senior);

    gross = price * qty;

    if (senior == 1)
        discount = gross * 15 / 100;
    else
        discount = 0;

    taxable = gross - discount;

    gst = taxable * 5 / 100;

    total = taxable + gst;

    net = (total > 1000) ? total - 50 : total;

    printf("Gross Amount = %.2f\n", gross);
    printf("Discount = %.2f\n", discount);
    printf("GST = %.2f\n", gst);
    printf("Total = %.2f\n", total);
    printf("Net Payable = %.2f\n", net);

    return 0;
}
